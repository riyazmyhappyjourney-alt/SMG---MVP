      <rect x="1280" y="560" width="40" height="18" />
      <rect x="1360" y="560" width="40" height="18" />
      <rect x="1440" y="560" width="40" height="18" />
      <rect x="1520" y="560" width="40" height="18" />
      <rect x="1600" y="560" width="40" height="18" />
      <rect x="1680" y="560" width="40" height="18" />
      <rect x="1760" y="560" width="40" height="18" />
      <rect x="1840" y="560" width="40" height="18" />
    </g>
  </g>

  <!-- 11. Foreground: Clean Asphalt Road Promenade -->
  <g id="asphaltRoad">
    <rect x="0" y="578" width="1920" height="102" fill="url(#asphaltGrad)" />
    <!-- White Dashed Lane Dividers -->
    <g fill="#FFFFFF" opacity="0.8">
      <rect x="60" y="625" width="80" height="6" rx="2" />
      <rect x="220" y="625" width="80" height="6" rx="2" />
