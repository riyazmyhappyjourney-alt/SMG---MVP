      <line x1="240" y1="535" x2="240" y2="555" />
      <line x1="270" y1="535" x2="270" y2="555" />
      <line x1="300" y1="535" x2="300" y2="555" />
      <line x1="330" y1="535" x2="330" y2="555" />
      <line x1="360" y1="535" x2="360" y2="555" />
      <line x1="390" y1="535" x2="390" y2="555" />
      <line x1="420" y1="535" x2="420" y2="555" />
      <line x1="450" y1="535" x2="450" y2="555" />
      <line x1="480" y1="535" x2="480" y2="555" />
      <line x1="510" y1="535" x2="510" y2="555" />
      <line x1="540" y1="535" x2="540" y2="555" />
      <line x1="570" y1="535" x2="570" y2="555" />
      <line x1="600" y1="535" x2="600" y2="555" />
      <line x1="630" y1="535" x2="630" y2="555" />
      <line x1="660" y1="535" x2="660" y2="555" />
      <line x1="690" y1="535" x2="690" y2="555" />
      <line x1="920" y1="535" x2="920" y2="555" />
      <line x1="950" y1="535" x2="950" y2="555" />
      <line x1="980" y1="535" x2="980" y2="555" />
      <line x1="1010" y1="535" x2="1010" y2="555" />
      <line x1="1040" y1="535" x2="1040" y2="555" />
      <line x1="1070" y1="535" x2="1070" y2="555" />
      <line x1="1100" y1="535" x2="1100" y2="555" />
      <line x1="1130" y1="535" x2="1130" y2="555" />
    </g>

    <!-- Heritage Street Lanterns -->
    <g fill="#1F2937">
      <rect x="40" y="515" width="4" height="40" />
      <polygon points="37,515 47,515 45,505 39,505" />
      <circle cx="42" cy="508" r="3" fill="#FFF9C4" />

      <rect x="475" y="515" width="4" height="40" />
      <polygon points="472,515 482,515 480,505 474,505" />
      <circle cx="477" cy="508" r="3" fill="#FFF9C4" />

      <rect x="1140" y="515" width="4" height="40" />
      <polygon points="1137,515 1147,515 1145,505 1139,505" />
      <circle cx="1142" cy="508" r="3" fill="#FFF9C4" />
    </g>
  </g>

  <!-- 9. Bengaluru Iconic Green & Yellow Auto-Rickshaw -->
  <g id="bengaluruAutoRickshaw" filter="url(#softShadow)">
    <!-- Yellow Canopy Roof -->
    <path d="M 1420 545 C 1420 530, 1435 520, 1455 520 L 1485 520 C 1495 520, 1502 530, 1500 545 Z" fill="#F4B400" stroke="#C49000" stroke-width="2" />
    
    <!-- Windshield & Cabin Frame -->
    <path d="M 1485 525 L 1498 545 L 1480 545 L 1475 525 Z" fill="#B3E5FC" opacity="0.8" stroke="#37474F" stroke-width="1.5" />
    
    <!-- Green Lower Body (Bengaluru Eco-Auto Green) -->
    <path d="M 1420 545 L 1502 545 L 1495 580 L 1430 580 L 1420 565 Z" fill="#0F9D58" stroke="#0B8043" stroke-width="2" />
    
    <!-- Driver Opening & Handlebar hint -->
    <rect x="1445" y="535" width="28" height="25" fill="#263238" rx="2" />
    <circle cx="1456" cy="542" r="6" fill="#795548" /> <!-- Driver silhouette -->

    <!-- Headlight -->
    <circle cx="1503" cy="558" r="3.5" fill="#FFF9C4" stroke="#F57F17" stroke-width="1" />
    <!-- Bumper -->
    <rect x="1498" y="575" width="8" height="5" fill="#455A64" rx="1" />

    <!-- Front & Rear Wheels -->
    <circle cx="1492" cy="582" r="10" fill="#212121" stroke="#616161" stroke-width="2" />
    <circle cx="1492" cy="582" r="4" fill="#B0BEC5" />
    <circle cx="1438" cy="582" r="10" fill="#212121" stroke="#616161" stroke-width="2" />
    <circle cx="1438" cy="582" r="4" fill="#B0BEC5" />
  </g>

  <!-- 10. Foreground: Black & White Striped Curb (Bengaluru Signature) -->
  <g id="blackWhiteCurb">
    <!-- Curb Top Edge Line -->
    <rect x="0" y="560" width="1920" height="18" fill="#1C2028" />
    <!-- Repeating White Curb Blocks (40px white, 40px black) -->
    <g fill="#FFFFFF">
      <rect x="0" y="560" width="40" height="18" />
      <rect x="80" y="560" width="40" height="18" />
      <rect x="160" y="560" width="40" height="18" />
