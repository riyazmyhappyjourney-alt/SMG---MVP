# ====================================================================
# SellMyGhar Environment Configuration Template (.env.example)
# Copy this file to .env or .env.local and populate with your credentials.
# NEVER commit production secrets or credentials to version control.
# ====================================================================

# 1. Server Environment & Network
NODE_ENV="development" # Set to 'production' in live deployment
PORT=3000
APP_URL="https://sellmyghar.in"
AUTH_JWT_ISSUER="https://sellmyghar.in"
AUTH_JWT_AUDIENCE="https://sellmyghar.in"

# 2. PostgreSQL Relational Database (Authoritative Source of Truth)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL="postgresql://postgres:your_secure_db_password@127.0.0.1:5432/sellmyghar_db"
PG_SSL_ALLOW_INSECURE="false" # Set 'true' only for local self-signed certificates

# 3. Cryptographic JWT Session Infrastructure (HS256 via jose)
# MUST be a cryptographically random secret of at least 32 characters (256 bits)
JWT_SECRET="generate_at_least_32_characters_random_secret_key_here!"

# 4. Privileged Account Initial Bootstrap Passwords
# Read strictly from environment during initial database bootstrap.
# Startup fails closed if privileged account does not exist and password is not provided.
# Existing passwords will NEVER be overwritten on server restarts.
INITIAL_STAFF_PASSWORD="SetStrongInitialStaffPassword#2026!"
INITIAL_ADMIN_PASSWORD="SetStrongInitialAdminPassword#2026!"

# 5. Supabase Cloud Storage (Public Media & Private Legal Documents)
# Used exclusively for Object Storage (Buckets: 'property-media', 'property-documents')
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_PROJECT_ID="your-project-id"

# 6. Enterprise Antivirus Engine (ClamAV Daemon TCP Sidecar)
# Connects via TCP INSTREAM protocol. Fails closed (quarantined) if unreachable.
CLAMAV_HOST="127.0.0.1"
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=2500

# 7. AI & Valuation Engine (Google Gemini API)
GEMINI_API_KEY="your_google_gemini_api_key_here"

# 8. Test & Sandbox Mode Flags (DEV / CI ONLY)
# When true, allows test double mocks without active TCP database connections
ALLOW_DEV_FALLBACKS="false"
